# Run commands from twillio/ so this .env is loaded.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Must exactly match the externally visible Twilio webhook URL (including query if any).
TWILIO_WEBHOOK_URL=https://your-host.tech/webhooks/twilio/inbound
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPERATOR_API_KEY=replace-with-a-long-random-secret
DATABASE_PATH=data/intake.sqlite3
# SMS follow-ups are stored but NOT sent until explicitly disabled.
SMS_DRY_RUN=true
SESSION_HOURS=6
