{
  "name": "floodbeacon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node build/server/index.js",
    "build:server": "vite build --config vite.server.config.ts",
    "db:reset": "npm run build:server && node build/server/seed.js --reset",
