{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floodbeacon-demo",
  "compatibility_date": "2026-10-10",
  "routes": [
    { "pattern": "floodbeacon.tech", "custom_domain": true },
    { "pattern": "www.floodbeacon.tech", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
